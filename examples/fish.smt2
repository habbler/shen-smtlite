; House positions run left to right, from 1 through 5.
(set-logic QF_BV)
(set-option :produce-models true)
(declare-const red (_ BitVec 3))
(assert (and (bvuge red #b001) (bvule red #b101)))
(declare-const green (_ BitVec 3))
(assert (and (bvuge green #b001) (bvule green #b101)))
(declare-const white (_ BitVec 3))
(assert (and (bvuge white #b001) (bvule white #b101)))
(declare-const yellow (_ BitVec 3))
(assert (and (bvuge yellow #b001) (bvule yellow #b101)))
(declare-const blue (_ BitVec 3))
(assert (and (bvuge blue #b001) (bvule blue #b101)))
(assert (distinct red green white yellow blue))

(declare-const brit (_ BitVec 3))
(assert (and (bvuge brit #b001) (bvule brit #b101)))
(declare-const swede (_ BitVec 3))
(assert (and (bvuge swede #b001) (bvule swede #b101)))
(declare-const dane (_ BitVec 3))
(assert (and (bvuge dane #b001) (bvule dane #b101)))
(declare-const german (_ BitVec 3))
(assert (and (bvuge german #b001) (bvule german #b101)))
(declare-const norwegian (_ BitVec 3))
(assert (and (bvuge norwegian #b001) (bvule norwegian #b101)))
(assert (distinct brit swede dane german norwegian))

(declare-const coffee (_ BitVec 3))
(assert (and (bvuge coffee #b001) (bvule coffee #b101)))
(declare-const tea (_ BitVec 3))
(assert (and (bvuge tea #b001) (bvule tea #b101)))
(declare-const milk (_ BitVec 3))
(assert (and (bvuge milk #b001) (bvule milk #b101)))
(declare-const beer (_ BitVec 3))
(assert (and (bvuge beer #b001) (bvule beer #b101)))
(declare-const water (_ BitVec 3))
(assert (and (bvuge water #b001) (bvule water #b101)))
(assert (distinct coffee tea milk beer water))

(declare-const pall_mall (_ BitVec 3))
(assert (and (bvuge pall_mall #b001) (bvule pall_mall #b101)))
(declare-const dunhill (_ BitVec 3))
(assert (and (bvuge dunhill #b001) (bvule dunhill #b101)))
(declare-const blends (_ BitVec 3))
(assert (and (bvuge blends #b001) (bvule blends #b101)))
(declare-const blue_master (_ BitVec 3))
(assert (and (bvuge blue_master #b001) (bvule blue_master #b101)))
(declare-const prince (_ BitVec 3))
(assert (and (bvuge prince #b001) (bvule prince #b101)))
(assert (distinct pall_mall dunhill blends blue_master prince))

(declare-const dogs (_ BitVec 3))
(assert (and (bvuge dogs #b001) (bvule dogs #b101)))
(declare-const birds (_ BitVec 3))
(assert (and (bvuge birds #b001) (bvule birds #b101)))
(declare-const cats (_ BitVec 3))
(assert (and (bvuge cats #b001) (bvule cats #b101)))
(declare-const horses (_ BitVec 3))
(assert (and (bvuge horses #b001) (bvule horses #b101)))
(declare-const fish (_ BitVec 3))
(assert (and (bvuge fish #b001) (bvule fish #b101)))
(assert (distinct dogs birds cats horses fish))

(assert (= blue #b010))
(assert (= norwegian #b001))
(assert (= milk #b011))
(assert (= brit red))
(assert (= green coffee))
(assert (= dane tea))
(assert (= yellow dunhill))
(assert (= pall_mall birds))
(assert (= beer blue_master))
(assert (= german prince))
(assert (= swede dogs))
(assert (= (bvadd green #b001) white))
(assert (or (= (bvadd blends #b001) cats) (= (bvadd cats #b001) blends)))
(assert (or (= (bvadd dunhill #b001) horses) (= (bvadd horses #b001) dunhill)))
(assert (or (= (bvadd blends #b001) water) (= (bvadd water #b001) blends)))

(check-sat)
(get-value (german fish))

; Block the complete arrangement to check uniqueness.
(assert (not (and
  (= red #b011) (= green #b100) (= white #b101) (= yellow #b001) (= blue #b010)
  (= brit #b011) (= swede #b101) (= dane #b010) (= german #b100) (= norwegian #b001)
  (= coffee #b100) (= tea #b010) (= milk #b011) (= beer #b101) (= water #b001)
  (= pall_mall #b011) (= dunhill #b001) (= blends #b010) (= blue_master #b101) (= prince #b100)
  (= dogs #b101) (= birds #b011) (= cats #b001) (= horses #b010) (= fish #b100)
)))
(check-sat)
